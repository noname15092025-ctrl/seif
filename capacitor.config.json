{
  "appId": "app.shut.wallet",
  "appName": "SHUT",
  "webDir": "www",
  "server": {
    "iosScheme": "capacitor",
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#121212",
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "backgroundColor": "#121212",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#121212",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_shut",
      "iconColor": "#C8E27A"
    }
  }
}
